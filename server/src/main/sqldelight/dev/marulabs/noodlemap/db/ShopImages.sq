-- Present in the prod DB; no handler reads/writes images today, only shop deletion clears them.
CREATE TABLE shop_images (
    id         TEXT AS java.util.UUID NOT NULL PRIMARY KEY,
    shop_id    TEXT AS java.util.UUID NOT NULL,
    path       TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (shop_id) REFERENCES shops (id)
);
-- (modtime trigger omitted; see note in Users.sq)

deleteShopImagesByShopId:
DELETE FROM shop_images WHERE shop_id = ?;
