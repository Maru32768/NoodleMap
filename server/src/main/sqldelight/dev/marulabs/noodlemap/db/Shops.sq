-- Ported from server/infra/db/shops.sql.go (sqlc).
CREATE TABLE shops (
    id              TEXT AS java.util.UUID NOT NULL PRIMARY KEY,
    name            TEXT NOT NULL,
    lat             REAL NOT NULL,
    lng             REAL NOT NULL,
    postal_code     TEXT NOT NULL,
    address         TEXT NOT NULL,
    google_place_id TEXT UNIQUE,
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    category        TEXT NOT NULL DEFAULT 'ramen' CHECK (category IN ('ramen', 'udon')),
    opened_at       TEXT,
    closed_at       TEXT,
    name_kana       TEXT
);

-- (modtime trigger omitted; see note in Users.sq)

-- eaten / rate are derived from the eaten_shops left join. The boolean
-- expression comes back as Long (0/1); the mapping layer converts to Boolean.
findAllShops:
SELECT r.id,
       r.name,
       r.name_kana,
       r.lat,
       r.lng,
       r.postal_code,
       r.address,
       r.opened_at,
       r.closed_at,
       r.google_place_id,
       r.category,
       CAST((vs.id IS NOT NULL) AS INTEGER)    AS eaten,
       CAST(COALESCE(vs.rate, 0.0) AS REAL)    AS rate
FROM shops r
LEFT JOIN eaten_shops vs ON r.id = vs.shop_id;

insertShop:
INSERT INTO shops (id, name, name_kana, lat, lng, postal_code, address, opened_at, closed_at, google_place_id, category)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateShop:
UPDATE shops
SET name            = :name,
    -- NULL keeps the stored reading; '' clears it.
    name_kana       = NULLIF(COALESCE(:nameKana, name_kana), ''),
    lat             = :lat,
    lng             = :lng,
    postal_code     = :postalCode,
    address         = :address,
    opened_at       = :openedAt,
    closed_at       = :closedAt,
    -- Same for the place id: NULL keeps it, '' clears it.
    google_place_id = NULLIF(COALESCE(:googlePlaceId, google_place_id), ''),
    category        = :category
WHERE id = :id;

deleteShop:
DELETE FROM shops WHERE id = ?;
