-- Ported from server/infra/db/shops.sql.go (sqlc).
CREATE TABLE shops (
    id              TEXT AS java.util.UUID NOT NULL PRIMARY KEY,
    name            TEXT NOT NULL,
    lat             REAL NOT NULL,
    lng             REAL NOT NULL,
    postal_code     TEXT NOT NULL,
    address         TEXT NOT NULL,
    google_place_id TEXT UNIQUE,
    created_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at      TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    category        TEXT NOT NULL DEFAULT 'ramen' CHECK (category IN ('ramen', 'udon')),
    opened_at       TEXT,
    closed_at       TEXT,
    name_kana       TEXT,
    wish_level      TEXT CHECK (wish_level IN ('low', 'medium', 'high'))
);

-- (modtime trigger omitted; see note in Users.sq)

-- 食べた / お気に入り度 are derived from visit_logs (VisitLogs.sq findAllVisitSummaries).
findAllShops:
SELECT r.id,
       r.name,
       r.name_kana,
       r.lat,
       r.lng,
       r.postal_code,
       r.address,
       r.opened_at,
       r.closed_at,
       r.google_place_id,
       r.category,
       r.wish_level
FROM shops r;

insertShop:
INSERT INTO shops (id, name, name_kana, lat, lng, postal_code, address, opened_at, closed_at, google_place_id, category, wish_level)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateShop:
UPDATE shops
SET name            = :name,
    -- NULL keeps the stored reading; '' clears it.
    name_kana       = NULLIF(COALESCE(:nameKana, name_kana), ''),
    lat             = :lat,
    lng             = :lng,
    postal_code     = :postalCode,
    address         = :address,
    opened_at       = :openedAt,
    closed_at       = :closedAt,
    -- Same for the place id: NULL keeps it, '' clears it.
    google_place_id = NULLIF(COALESCE(:googlePlaceId, google_place_id), ''),
    category        = :category,
    -- Same for the 気になる度: NULL keeps it, '' clears it.
    wish_level      = NULLIF(COALESCE(:wishLevel, wish_level), '')
WHERE id = :id;

shopExists:
SELECT EXISTS (SELECT 1 FROM shops WHERE id = ?);

deleteShop:
DELETE FROM shops WHERE id = ?;
