-- Ported from server/infra/db/shops.sql.go (sqlc).
CREATE TABLE eaten_shops (
    id         TEXT AS java.util.UUID NOT NULL PRIMARY KEY,
    shop_id    TEXT AS java.util.UUID NOT NULL UNIQUE,
    rate       REAL NOT NULL,
    favorite   INTEGER AS kotlin.Boolean NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (shop_id) REFERENCES shops (id)
);

-- (modtime trigger omitted; see note in Users.sq)

upsertEatenShop:
INSERT INTO eaten_shops(id, shop_id, rate, favorite)
VALUES (?, ?, ?, ?)
ON CONFLICT(shop_id)
DO UPDATE SET rate = excluded.rate, favorite = excluded.favorite;

deleteEatenShopByShopId:
DELETE FROM eaten_shops WHERE shop_id = ?;
