CREATE TABLE venues (
    id TEXT AS java.util.UUID NOT NULL PRIMARY KEY,
    name TEXT NOT NULL UNIQUE
);

insertVenue:
INSERT INTO venues (id, name) VALUES (?, ?) ON CONFLICT (name) DO NOTHING;

findVenueByName:
SELECT * FROM venues WHERE name = ?;

findVenue:
SELECT * FROM venues WHERE id = ?;

-- Only venues some meal record names: a venue whose last record moved or went keeps its row, so its page
-- still answers, but leaves the list that suggests names.
findVenues:
SELECT * FROM venues WHERE EXISTS (SELECT 1 FROM meal_records WHERE meal_records.venue_id = venues.id) ORDER BY name, id;
