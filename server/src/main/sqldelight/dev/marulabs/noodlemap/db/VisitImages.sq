-- 訪問画像. The JPEG lives in object storage under storage_key (visits/VisitImageStore.kt).
CREATE TABLE visit_images (
    id           TEXT AS java.util.UUID NOT NULL PRIMARY KEY,
    visit_log_id TEXT AS java.util.UUID NOT NULL,
    storage_key  TEXT NOT NULL,
    width        INTEGER NOT NULL CHECK (width > 0),
    height       INTEGER NOT NULL CHECK (height > 0),
    caption      TEXT CHECK (length(caption) <= 100),
    sort_order   INTEGER NOT NULL,
    created_at   TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at   TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (visit_log_id) REFERENCES visit_logs (id)
);

CREATE INDEX idx_visit_images_visit_log_id ON visit_images (visit_log_id);

-- (modtime trigger omitted; see note in Users.sq)

-- Appends after the visit's last image; the INSERT itself writes first, so no read precedes it in the transaction.
appendVisitImage:
INSERT INTO visit_images (id, visit_log_id, storage_key, width, height, sort_order)
SELECT :id, :visitLogId, :storageKey, :width, :height, ifnull(max(sort_order) + 1, 0)
FROM visit_images
WHERE visit_log_id = :visitLogId;

countVisitImages:
SELECT count(*) FROM visit_images WHERE visit_log_id = ?;

findVisitImage:
SELECT * FROM visit_images WHERE id = ?;

findVisitImagesByVisitLogIds:
SELECT *
FROM visit_images
WHERE visit_log_id IN ?
ORDER BY visit_log_id, sort_order;

updateVisitImageCaption:
UPDATE visit_images SET caption = :caption WHERE id = :id;

updateVisitImageSortOrder:
UPDATE visit_images SET sort_order = :sortOrder WHERE id = :id AND visit_log_id = :visitLogId;

deleteVisitImage:
DELETE FROM visit_images WHERE id = ? RETURNING storage_key;

deleteVisitImagesByVisitLogId:
DELETE FROM visit_images WHERE visit_log_id = ? RETURNING storage_key;

-- The first image of every visit log that has images, with what the "latest visit" order needs, so the
-- shop list derives 代表写真 in one query. Unordered, like the visit log reads (see VisitLogs.sq).
findAllVisitCovers:
SELECT v.shop_id, v.id AS visit_log_id, v.visited_on, v.created_at, i.storage_key
FROM visit_images i
JOIN visit_logs v ON v.id = i.visit_log_id
WHERE i.sort_order = (SELECT min(sort_order) FROM visit_images WHERE visit_log_id = i.visit_log_id);
