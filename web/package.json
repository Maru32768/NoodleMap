{
  "name": "noodle-map-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --mode https",
    "dev:http": "vite --host",
    "build": "tsc -b && vite build",
    "check": "npm run check:mojibake && npm run lint && tsc -b",
    "basemap:extract": "node scripts/extract-basemap.mjs",
    "basemap:upload": "node scripts/upload-basemap-r2.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:coverage": "vitest run --project unit --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.2.3",
