    "@react-router/node": "^7.14.2",
    "dayjs": "^1.11.21",
    "es-toolkit": "^1.31.0",
    "exifr": "7.1.3",
    "isbot": "^5",
    "jotai": "^2.10.3",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.39.0",
    "next-themes": "^0.4.4",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-geolocated": "^4.3.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "react-modal-sheet": "^5.6.0",
    "react-router": "^7.14.2",
    "react-select": "^5.9.0",
    "react-virtuoso": "^4.18.6",
    "swr": "^2.4.0",
    "use-debounce": "^10.0.4"
