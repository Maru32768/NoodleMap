DB_PATH=./data/noodle_map.db
SERVER_PORT=8888
GOOGLE_OAUTH_CLIENT_ID=
ADMIN_EMAIL=
GOOGLE_PLACES_API_KEY=
AUTH_COOKIE_SECURE=false
# Shared R2 connection: set all three together before enabling any R2 feature.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=db-backup
OG_R2_BUCKET=
OG_R2_PUBLIC_BASE_URL=
VISIT_IMAGES_R2_BUCKET=
VISIT_IMAGES_R2_PUBLIC_BASE_URL=
# Separate R2 credentials for the Terraform state backend; exclude state from the app token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=
