-- Ported from server/infra/db/shops.sql.go (sqlc).
CREATE TABLE shops_tags (
    id         TEXT AS java.util.UUID NOT NULL PRIMARY KEY,
    shop_id    TEXT AS java.util.UUID NOT NULL,
    tag_id     TEXT AS java.util.UUID NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (shop_id) REFERENCES shops (id) ON DELETE CASCADE,
    FOREIGN KEY (tag_id) REFERENCES tags (id) ON DELETE CASCADE,
    UNIQUE (shop_id, tag_id)
);

CREATE INDEX idx_shops_tags_shop_id ON shops_tags (shop_id);
CREATE INDEX idx_shops_tags_tag_id ON shops_tags (tag_id);

-- (modtime trigger omitted; see note in Users.sq)

insertShopTag:
INSERT INTO shops_tags (id, shop_id, tag_id) VALUES (?, ?, ?);

deleteShopTagsByShopId:
DELETE FROM shops_tags WHERE shop_id = ?;

-- SQLDelight expands `IN ?` to a bound collection (covers sqlc's /*SLICE:*/ case).
findTagsByShopIds:
SELECT st.shop_id,
       t.id,
       t.category,
       t.label,
       t.slug,
       t.color,
       t.sort_order
FROM shops_tags st
JOIN tags t ON st.tag_id = t.id
WHERE st.shop_id IN ?
ORDER BY st.shop_id, t.sort_order, t.label;
